# Copy to .env. Everything here is optional.
# ANTHROPIC_API_KEY=sk-ant-...      # turns on "Ask Plato"
# PLATO_MODEL=claude-opus-5-5
# PLATO_PORT=8765
# PLATO_HOST=127.0.0.1              # 0.0.0.0 lets other machines open /s/<slug> pages (nothing else)
# PLATO_CONTACT=you@example.com     # added to the Nominatim User-Agent, as their policy asks
# PLATO_PASSWORD=choose-a-long-one  # with PLATO_HOST=0.0.0.0: use the whole app from a phone or a cloud host (any user name)
